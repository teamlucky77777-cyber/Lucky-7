<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>🍀 Lucky 7</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;background:#f0f2f5;color:#1a1a2e;min-height:100vh}

/* AUTH SCREEN */
#auth-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a2332,#1D9E75)}
.auth-box{background:#fff;border-radius:16px;padding:36px;width:400px}
.auth-logo{text-align:center;font-size:48px;margin-bottom:8px}
.auth-title{text-align:center;font-size:22px;font-weight:700;margin-bottom:4px}
.auth-sub{text-align:center;font-size:12px;color:#aaa;margin-bottom:24px}
.auth-tabs{display:flex;gap:0;margin-bottom:20px;border:1px solid #e5e9f0;border-radius:8px;overflow:hidden}
.auth-tab{flex:1;padding:8px;font-size:12px;font-weight:500;border:none;background:#f8f9fb;cursor:pointer;color:#888;font-family:inherit}
.auth-tab.on{background:#1D9E75;color:#fff}
.auth-err{background:#ffebee;color:#b71c1c;border-radius:8px;padding:8px 12px;font-size:12px;margin-bottom:12px}
.auth-ok{background:#e8f5e9;color:#1b5e20;border-radius:8px;padding:8px 12px;font-size:12px;margin-bottom:12px}
.fg{margin-bottom:10px}
.fg label{display:block;font-size:11px;color:#555;margin-bottom:3px;font-weight:500}
.fg input,.fg select{width:100%;padding:8px 10px;border:1px solid #dde1e7;border-radius:6px;font-size:12px;font-family:inherit;color:#1a1a2e;outline:none}
.fg input:focus,.fg select:focus{border-color:#1D9E75}
.role-pick{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px}
.role-opt{padding:8px;border:1.5px solid #e5e9f0;border-radius:8px;cursor:pointer;text-align:center;font-size:12px;transition:.1s;background:#fff}
.role-opt:hover{border-color:#1D9E75;background:#f0faf5}
.role-opt.on{border-color:#1D9E75;background:#e8f5e9;color:#1b5e20;font-weight:500}
.role-opt .ro-icon{font-size:20px;display:block;margin-bottom:3px}
.invite-field{display:none}
.invite-field.show{display:block}

/* APP */
#app-screen{display:none}
#app{display:flex;min-height:100vh}
#sb{width:205px;background:#1a2332;color:#fff;display:flex;flex-direction:column;min-height:100vh;flex-shrink:0}
.sb-top{padding:16px 14px 12px;border-bottom:1px solid #2a3545}
.sb-brand{font-size:15px;font-weight:700}
.sb-user{font-size:11px;color:#7a8fa6;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sb-badge{display:inline-block;font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px;margin-top:5px}
.sb-ceo{background:#854F0B;color:#ffd580}
.sb-manager{background:#1D9E75;color:#fff}
.sb-settlement{background:#185FA5;color:#b5d4f4}
.sb-hr{background:#534AB7;color:#cecbf6}
.sb-staff{background:#2a3545;color:#7a8fa6}
.sb-player{background:#791F1F;color:#f09595}
.sb-nav{flex:1;padding:8px 0}
.ni{display:flex;align-items:center;gap:9px;padding:10px 14px;cursor:pointer;color:#7a8fa6;border-left:3px solid transparent;font-size:13px;transition:.1s}
.ni:hover{background:#243040;color:#fff}
.ni.on{background:#1D9E75;color:#fff;border-left-color:#a8f0d6}
.sb-bot{padding:12px 14px;border-top:1px solid #2a3545}
.lbtn{flex:1;padding:6px;font-size:11px;border-radius:6px;border:1px solid #2a3545;background:transparent;color:#7a8fa6;cursor:pointer;font-family:inherit}
.lbtn.on{background:#1D9E75;color:#fff;border-color:#1D9E75}
.signout{width:100%;margin-top:8px;padding:7px;font-size:11px;border-radius:6px;border:1px solid #2a3545;background:transparent;color:#7a8fa6;cursor:pointer;font-family:inherit}
.signout:hover{background:#2a3545;color:#fff}

/* MAIN */
#main{flex:1;padding:24px;overflow:auto}
.ph{font-size:18px;font-weight:700;margin-bottom:4px}
.psub{font-size:12px;color:#aaa;margin-bottom:20px}
.sh{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#aaa;margin-bottom:10px}
.shr{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}

/* METRICS */
.mets{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}
.met{background:#fff;border-radius:10px;padding:14px 16px;border:1px solid #e5e9f0}
.mv{font-size:26px;font-weight:700;line-height:1.1}
.ml{font-size:11px;color:#888;margin-top:3px}
.cg{color:#1D9E75}.cb{color:#185FA5}.ca{color:#BA7517}.cr{color:#A32D2D}

/* BADGES */
.bdg{display:inline-block;font-size:11px;font-weight:500;padding:2px 9px;border-radius:20px}
.bs{background:#e8f5e9;color:#1b5e20}.bi{background:#e3f2fd;color:#0d47a1}
.bw{background:#fff3e0;color:#e65100}.bx{background:#f5f5f5;color:#555}.bd{background:#ffebee;color:#b71c1c}
.pb{display:inline-block;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px}
.pbp1{background:#ffebee;color:#b71c1c}.pbp2{background:#fff3e0;color:#e65100}.pbp3{background:#e3f2fd;color:#0d47a1}

/* CARDS & TABLES */
.tgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:10px;margin-bottom:24px}
.tcard{background:#fff;border:1px solid #e5e9f0;border-radius:12px;padding:14px}
.tc-head{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.tc-row{display:flex;justify-content:space-between;align-items:center;font-size:11px;padding:4px 0;border-bottom:1px solid #f5f5f5}
.tc-row:last-child{border:none}
.tw{background:#fff;border-radius:12px;border:1px solid #e5e9f0;overflow:hidden;margin-bottom:20px}
table{width:100%;border-collapse:collapse}
thead{background:#f8f9fb}
th{padding:8px 12px;font-size:11px;color:#888;font-weight:500;text-align:left;border-bottom:1px solid #e5e9f0;white-space:nowrap}
td{padding:9px 12px;font-size:12px;border-bottom:1px solid #f5f7fa;color:#1a1a2e;vertical-align:middle}
tr:last-child td{border-bottom:none}
tr:hover td{background:#fafbfc}
.erow>td{padding:0!important;border-bottom:1px solid #e5e9f0!important}
.erow-in{background:#e8f4ff;padding:14px 16px;border-left:3px solid #1565c0}

/* BUTTONS */
button{font-family:inherit;font-size:12px;padding:6px 12px;border-radius:8px;border:1px solid #dde1e7;background:#fff;color:#1a1a2e;cursor:pointer}
button:hover{background:#f5f5f5}
.btn-add{background:#1D9E75;color:#fff;border-color:#1D9E75}
.btn-add:hover{background:#0F6E56}
.btn-del{background:none;border:none;color:#c62828;cursor:pointer;padding:4px;font-size:13px}
.btn-sm{font-size:11px;padding:4px 9px;border-radius:6px}
.btn-full{width:100%;margin-top:14px}

/* FORM BOX */
.fbox{background:#e8f4ff;border:1px solid #90caf9;border-radius:10px;padding:16px;margin-bottom:16px;border-left:3px solid #1565c0}
.fbox-t{font-weight:700;font-size:13px;color:#1565c0;margin-bottom:12px}
.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(115px,1fr));gap:10px;margin-bottom:12px}
.fg2 label{display:block;font-size:11px;color:#555;margin-bottom:3px}
.fg2 input,.fg2 select,.fg2 textarea{width:100%;padding:7px 10px;border:1px solid #dde1e7;border-radius:6px;font-size:12px;font-family:inherit;color:#1a1a2e;outline:none;background:#fff}
.fg2 input:focus,.fg2 select:focus{border-color:#1D9E75}
.fg2 textarea{resize:vertical}

/* PC GRID */
.pcgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:8px}
.pcc{border-radius:8px;padding:10px 4px;text-align:center}
.pcc.clickable{cursor:pointer;transition:.1s}.pcc.clickable:hover{transform:scale(1.04)}
.pcc-on{background:#e8f5e9;border:1px solid #a5d6a7}
.pcc-on .pcc-n{color:#1b5e20}.pcc-on .pcc-s{color:#2e7d32}
.pcc-warn{background:#fff3e0;border:1px solid #ffb74d}
.pcc-warn .pcc-n,.pcc-warn .pcc-s{color:#e65100}
.pcc-off{background:#ffebee;border:1px solid #ef9a9a}
.pcc-off .pcc-n,.pcc-off .pcc-s{color:#b71c1c}
.pcc-n{font-size:12px;font-weight:700}.pcc-s{font-size:10px;opacity:.8;margin-top:1px}

/* TASKS */
.tlist{background:#fff;border-radius:12px;border:1px solid #e5e9f0;overflow:hidden;margin-bottom:16px}
.trow{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #f5f7fa}
.trow:last-child{border:none}
.trow.done{opacity:.55;background:#fafbfc}
.tcheck{width:18px;height:18px;border-radius:4px;border:2px solid #ccc;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px}
.tcheck.on{background:#1D9E75;border-color:#1D9E75;color:#fff}
.ttxt{flex:1;font-size:12px}
.ttxt.s{text-decoration:line-through;color:#aaa}
.pills{display:flex;gap:6px;flex-wrap:wrap}
.pill{font-size:11px;padding:4px 10px;border-radius:20px;border:1px solid #dde1e7;background:#fff;cursor:pointer;color:#666}
.pill.on{background:#1D9E75;color:#fff;border-color:#1D9E75}

/* PIPELINE */
.pipe{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.pc-col{background:#f8f9fb;border-radius:10px;padding:12px}
.pc-col-h{font-size:12px;font-weight:700;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.pc-cnt{font-size:11px;background:#fff;border:1px solid #e0e0e0;border-radius:20px;padding:2px 7px;color:#666}
.pc-card{background:#fff;border:1px solid #e5e9f0;border-radius:8px;padding:9px 10px;margin-bottom:6px}
.pc-name{font-weight:700;font-size:12px;margin-bottom:2px}
.pc-meta{font-size:11px;color:#aaa;margin-bottom:6px}

/* REPORTS */
.rlayout{display:grid;grid-template-columns:190px 1fr;gap:16px}
.ritem{padding:10px 12px;border-radius:8px;cursor:pointer;background:#f8f9fb;border:1px solid #e5e9f0;margin-bottom:6px}
.ritem.on{background:#e3f2fd;border-color:#90caf9}
.rview{background:#fff;border:1px solid #e5e9f0;border-radius:12px;padding:20px}
.rsnap{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:20px}
.rsc{background:#f8f9fb;border-radius:8px;padding:10px;text-align:center}
.rsv{font-size:22px;font-weight:700}.rsl{font-size:11px;color:#888}
.rsec{margin-bottom:14px}
.rsec-t{font-size:12px;font-weight:700;border-bottom:1px solid #eee;padding-bottom:4px;margin-bottom:6px}
.rsec-b{font-size:12px;color:#444;line-height:1.7;white-space:pre-wrap}
.rempty{display:flex;align-items:center;justify-content:center;height:180px;font-size:13px;color:#aaa;border:1px dashed #dde1e7;border-radius:12px}

/* INVITE CODES */
.code-card{background:#fff;border:1px solid #e5e9f0;border-radius:10px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:12px}
.code-role{display:inline-block;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;text-transform:uppercase;width:100px;text-align:center}
.code-val{flex:1;font-family:monospace;font-size:13px;font-weight:600;color:#1a1a2e;background:#f8f9fb;padding:6px 10px;border-radius:6px;border:1px solid #e5e9f0;letter-spacing:.5px}
.code-used{text-decoration:line-through;color:#aaa}
.code-status{font-size:11px;color:#aaa}

/* PLAYER PORTAL */
.player-wrap{max-width:540px;margin:0 auto}
.player-hero{background:linear-gradient(135deg,#1a2332,#1D9E75);border-radius:16px;padding:28px 24px;color:#fff;margin-bottom:20px;text-align:center}
.player-char{font-size:28px;font-weight:700;margin-bottom:4px}
.player-server{font-size:13px;opacity:.8;margin-bottom:16px}
.player-status-big{display:inline-block;font-size:13px;font-weight:600;padding:6px 18px;border-radius:20px;background:rgba(255,255,255,.2)}
.player-card{background:#fff;border:1px solid #e5e9f0;border-radius:12px;padding:18px 20px;margin-bottom:12px}
.player-card-title{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#aaa;margin-bottom:12px}
.player-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f5f5f5;font-size:13px}
.player-row:last-child{border:none}
.player-key{color:#888}
.player-val{font-weight:600}
.player-note{background:#f0faf5;border:1px solid #a5d6a7;border-radius:8px;padding:12px 14px;font-size:12px;color:#1b5e20;line-height:1.6}
.player-none{text-align:center;padding:60px 20px;color:#aaa}
.player-none .player-icon{font-size:48px;margin-bottom:12px}

/* MISC */
.av{border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0}
.nodata{padding:20px;text-align:center;font-size:12px;color:#aaa}
.tip{font-size:11px;color:#aaa;margin-bottom:16px}
.info-tag{font-size:11px;background:#e3f2fd;color:#0d47a1;padding:4px 10px;border-radius:20px;display:inline-block;margin-bottom:12px}
</style>
</head>
<body>

<!-- ═══ AUTH SCREEN ═══ -->
<div id="auth-screen">
  <div class="auth-box">
    <div class="auth-logo">🍀</div>
    <div class="auth-title">Lucky 7</div>
    <div class="auth-sub" id="auth-sub">Sign in to your account</div>
    <div class="auth-tabs">
      <button class="auth-tab on" onclick="showTab('in')">Sign In</button>
      <button class="auth-tab" onclick="showTab('up')">Create Account</button>
    </div>
    <div id="auth-msg" style="display:none"></div>

    <!-- SIGN IN -->
    <div id="tab-in">
      <div class="fg"><label>Email</label><input type="email" id="si-email" placeholder="your@email.com" onkeydown="if(event.key==='Enter')signIn()"></div>
      <div class="fg"><label>Password</label><input type="password" id="si-pass" placeholder="••••••••" onkeydown="if(event.key==='Enter')signIn()"></div>
      <button class="btn-add btn-full" id="si-btn" onclick="signIn()">Sign In</button>
    </div>

    <!-- SIGN UP -->
    <div id="tab-up" style="display:none">
      <div class="fg"><label>Full name</label><input id="su-name" placeholder="Your name"></div>
      <div class="fg"><label>Email</label><input type="email" id="su-email" placeholder="your@email.com"></div>
      <div class="fg"><label>Password</label><input type="password" id="su-pass" placeholder="Min 6 characters"></div>
      <div class="fg">
        <label>I am a...</label>
        <div class="role-pick">
          <div class="role-opt on" onclick="pickRole('player')" id="ropt-player">
            <span class="ro-icon">🎮</span>Player
          </div>
          <div class="role-opt" onclick="pickRole('staff')" id="ropt-staff">
            <span class="ro-icon">🖥</span>Staff / Team
          </div>
        </div>
      </div>
      <div class="invite-field fg" id="invite-field">
        <label>Invite code <span style="color:#aaa;font-weight:400">(given by your manager)</span></label>
        <input id="su-code" placeholder="e.g. MGR-LUCKY7-BALEN" style="font-family:monospace;letter-spacing:.5px">
      </div>
      <button class="btn-add btn-full" id="su-btn" onclick="signUp()">Create Account</button>
    </div>
  </div>
</div>

<!-- ═══ APP SCREEN ═══ -->
<div id="app-screen">
  <div id="app">
    <nav id="sb">
      <div class="sb-top">
        <div class="sb-brand">🍀 Lucky 7</div>
        <div class="sb-user" id="sb-name">...</div>
        <div id="sb-badge"></div>
      </div>
      <div class="sb-nav" id="nav-links"></div>
      <div class="sb-bot">
        <div style="display:flex;gap:4px;margin-bottom:8px">
          <button class="lbtn on" id="btn-en" onclick="setLang('en')">EN</button>
          <button class="lbtn" id="btn-ko" onclick="setLang('ko')">한국어</button>
        </div>
        <button class="signout" onclick="signOut()">← Sign out</button>
      </div>
    </nav>
    <main id="main"><div style="padding:40px;text-align:center;color:#aaa">Loading...</div></main>
  </div>
</div>

<script>
const SUPABASE_URL = 'https://wluwntzsllynpcwecwdp.supabase.co';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndsdXdudHpzbGx5bnBjd2Vjd2RwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkxNTQ1NzQsImV4cCI6MjA5NDczMDU3NH0.jIZlpmZuMCJjhBHQbpDMSQzL0v81aVoaDPJkpL2zTiM';

const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

// ── PERMISSIONS ──────────────────────────────────────────────────────────
const PERMS = {
  ceo:        ['dash','pcs_view','pcs_edit','tasks_view','tasks_edit','tasks_done','clients','recruitment','team','reports','users','invite'],
  manager:    ['dash','pcs_view','pcs_edit','tasks_view','tasks_edit','tasks_done','clients','recruitment','team','reports','users','invite'],
  settlement: ['dash','clients'],
  hr:         ['dash','tasks_view','tasks_edit','tasks_done','recruitment','team'],
  staff:      ['dash','pcs_view','tasks_view','tasks_done'],
  player:     ['player']
};
const can = (f) => (PERMS[S.profile?.role||'player']||[]).includes(f);

const ROLE_LABELS = { ceo:'CEO', manager:'Manager', settlement:'Settlement', hr:'HR', staff:'Staff', player:'Player' };
const ROLE_ICONS = { ceo:'👑', manager:'🟢', settlement:'💰', hr:'👥', staff:'🖥', player:'🎮' };

const NAV_ITEMS = [
  { key:'dashboard', label:'Dashboard', labelKo:'대시보드', icon:'ti-home', perm:'dash' },
  { key:'pcs', label:'Korea PCs', labelKo:'한국 PC', icon:'ti-device-desktop', perm:'pcs_view' },
  { key:'tasks', label:'Tasks', labelKo:'업무', icon:'ti-checkbox', perm:'tasks_view' },
  { key:'clients', label:'Clients', labelKo:'클라이언트', icon:'ti-briefcase', perm:'clients' },
  { key:'team', label:'Team', labelKo:'팀', icon:'ti-users', perm:'team' },
  { key:'reports', label:'Reports', labelKo:'보고서', icon:'ti-file-description', perm:'reports' },
  { key:'invite', label:'Invite Codes', labelKo:'초대 코드', icon:'ti-key', perm:'invite' },
  { key:'users', label:'User Roles', labelKo:'사용자 역할', icon:'ti-shield', perm:'users' },
  { key:'player', label:'My Order', labelKo:'내 주문', icon:'ti-sword', perm:'player' },
];

// ── STATE ─────────────────────────────────────────────────────────────────
const ISP_OPT=['IndiHome','MyRepublic','Biznet','Other'];
const TOOL_OPT=['AnyViewer','Tailscale+Veyon','Rimo+VPN','MeshCentral','Other'];

let S = {
  page:'dashboard', lang:'en', user:null, profile:null,
  team:[], tasks:[], pcs:[], clients:[], recruits:[], reports:[], codes:[],
  editMember:null, showAddMember:false, showAddRecruit:false,
  showAddTask:false, showAddClient:false, showAddReport:false, showAddCode:false,
  viewReport:null, taskFilter:'All', signupRole:'player'
};

const esc=s=>(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const ac=n=>(['#185FA5','#0F6E56','#854F0B','#791F1F','#534AB7','#993556','#444441'])[(n||'?').charCodeAt(0)%7];
const sc=s=>({Active:'bs',Online:'bs',Done:'bs',Completed:'bs',Hired:'bs','In Progress':'bi',Interview:'bi',Trial:'bw',Warning:'bw',Applied:'bw',Inactive:'bx',Todo:'bx',Offline:'bd',Paused:'bd'}[s]||'bx');
const bdg=s=>`<span class="bdg ${sc(s)}">${s}</span>`;
const pb=p=>`<span class="pb pb${p.toLowerCase()}">${p}</span>`;
const av=(n,i,sz=30)=>{const c=ac(n);return`<div class="av" style="width:${sz}px;height:${sz}px;font-size:${Math.round(sz*.36)}px;background:${c}22;border:1.5px solid ${c};color:${c}">${(i||n.slice(0,2)).toUpperCase()}</div>`;};

// ── AUTH ──────────────────────────────────────────────────────────────────
let signupRole = 'player';

function showTab(tab){
  document.getElementById('tab-in').style.display=tab==='in'?'block':'none';
  document.getElementById('tab-up').style.display=tab==='up'?'block':'none';
  document.querySelectorAll('.auth-tab').forEach((b,i)=>b.classList.toggle('on',['in','up'][i]===tab));
  document.getElementById('auth-msg').style.display='none';
  document.getElementById('auth-sub').textContent=tab==='in'?'Sign in to your account':'Create your account';
}

function pickRole(r){
  signupRole=r;
  document.querySelectorAll('.role-opt').forEach(el=>el.classList.remove('on'));
  document.getElementById(`ropt-${r}`).classList.add('on');
  const inv=document.getElementById('invite-field');
  inv.classList.toggle('show',r!=='player');
}

function showMsg(msg,type='err'){
  const el=document.getElementById('auth-msg');
  el.className=type==='ok'?'auth-ok':'auth-err';
  el.textContent=msg;el.style.display='block';
}

async function signIn(){
  const email=document.getElementById('si-email').value.trim();
  const pass=document.getElementById('si-pass').value;
  if(!email||!pass){showMsg('Please enter email and password.');return;}
  document.getElementById('si-btn').textContent='Signing in...';
  document.getElementById('si-btn').disabled=true;
  const {error}=await sb.auth.signInWithPassword({email,password:pass});
  if(error){showMsg(error.message);document.getElementById('si-btn').textContent='Sign In';document.getElementById('si-btn').disabled=false;}
}

async function signUp(){
  const name=document.getElementById('su-name').value.trim();
  const email=document.getElementById('su-email').value.trim();
  const pass=document.getElementById('su-pass').value;
  const code=document.getElementById('su-code').value.trim();
  if(!name||!email||!pass){showMsg('Please fill in all fields.');return;}
  if(pass.length<6){showMsg('Password must be at least 6 characters.');return;}
  if(signupRole!=='player'&&!code){showMsg('Please enter your invite code.');return;}
  document.getElementById('su-btn').textContent='Creating account...';
  document.getElementById('su-btn').disabled=true;
  const {error}=await sb.auth.signUp({email,password:pass,options:{data:{name}}});
  if(error){showMsg(error.message);document.getElementById('su-btn').textContent='Create Account';document.getElementById('su-btn').disabled=false;return;}
  if(signupRole!=='player'&&code){
    await new Promise(r=>setTimeout(r,1500));
    const {data:result}=await sb.rpc('redeem_invite_code',{p_code:code});
    if(result==='invalid'){showMsg('Account created but invite code was invalid. Your role is set to Player for now — contact your manager.',null);return;}
  }
  showMsg('Account created! Check your email to confirm, then sign in.','ok');
  document.getElementById('su-btn').textContent='Create Account';
  document.getElementById('su-btn').disabled=false;
}

async function signOut(){await sb.auth.signOut();location.reload();}

// ── APP INIT ──────────────────────────────────────────────────────────────
async function init(){
  const {data:{session}}=await sb.auth.getSession();
  if(session) await onLogin(session.user);
  else showAuth();
  sb.auth.onAuthStateChange(async(_,sess)=>{if(sess)await onLogin(sess.user);else showAuth();});
}

function showAuth(){document.getElementById('auth-screen').style.display='flex';document.getElementById('app-screen').style.display='none';}

async function onLogin(user){
  S.user=user;
  const {data:p}=await sb.from('user_profiles').select('*').eq('id',user.id).single();
  S.profile=p||{name:user.email,initials:'??',role:'player'};
  document.getElementById('auth-screen').style.display='none';
  document.getElementById('app-screen').style.display='block';
  document.getElementById('sb-name').textContent=S.profile.name;
  document.getElementById('sb-badge').innerHTML=`<span class="sb-badge sb-${S.profile.role}">${ROLE_ICONS[S.profile.role]||''} ${ROLE_LABELS[S.profile.role]||S.profile.role}</span>`;
  S.page = S.profile.role==='player' ? 'player' : 'dashboard';
  await loadAll();
  render();
}

async function loadAll(){
  const role=S.profile?.role||'player';
  if(role==='player'){
    const {data}=await sb.from('clients').select('*').eq('player_email',S.user.email);
    S.playerOrder=data?.[0]||null; return;
  }
  const loads=[sb.from('user_profiles').select('*'),sb.from('tasks').select('*').order('created_at'),sb.from('korea_pcs').select('*').order('num')];
  if(can('clients')) loads.push(sb.from('clients').select('*').order('created_at')); else loads.push(Promise.resolve({data:[]}));
  if(can('recruitment')) loads.push(sb.from('recruits').select('*').order('created_at')); else loads.push(Promise.resolve({data:[]}));
  if(can('reports')) loads.push(sb.from('reports').select('*').order('created_at',{ascending:false})); else loads.push(Promise.resolve({data:[]}));
  if(can('invite')) loads.push(sb.from('invite_codes').select('*').order('created_at')); else loads.push(Promise.resolve({data:[]}));
  const [t,tk,pc,cl,rec,rep,codes]=await Promise.all(loads);
  S.team=t.data||[];S.tasks=tk.data||[];S.pcs=pc.data||[];
  S.clients=cl.data||[];S.recruits=rec.data||[];S.reports=rep.data||[];S.codes=codes.data||[];
}

