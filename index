function pgReports(){
  const viewed=S.reports.find(r=>r.id===S.viewReport);
  const addF=S.showAddReport?`<div class="fbox"><div class="fbox-t">${S.lang==='ko'?'새 보고서':'Create report'}</div><div class="fg2" style="margin-bottom:10px"><label>${S.lang==='ko'?'주차':'Week'}</label><input id="rp-wk" placeholder="2026 W21"></div>${[['rp-sum',S.lang==='ko'?'요약':'Summary'],['rp-don',S.lang==='ko'?'완료':'Done this week'],['rp-stk',S.lang==='ko'?'이슈':'Issues'],['rp-nxt',S.lang==='ko'?'다음 주':'Next week']].map(([id,l])=>`<div class="fg2" style="margin-bottom:10px"><label>${l}</label><textarea id="${id}" rows="3" placeholder="${l}..." style="width:100%;padding:8px 10px;border:1px solid #dde1e7;border-radius:6px;font-size:12px;font-family:inherit;outline:none;resize:vertical;background:#fff;color:#1a1a2e"></textarea></div>`).join('')}<div style="display:flex;gap:8px"><button class="btn-add" onclick="addReport()">${S.lang==='ko'?'저장':'Save'}</button><button onclick="S.showAddReport=false;render()">${S.lang==='ko'?'취소':'Cancel'}</button></div></div>`:'';
  const vH=viewed?`<div class="rview"><div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px"><div><div style="font-size:16px;font-weight:700">${esc(viewed.week_label)}</div><div style="font-size:11px;color:#aaa">${new Date(viewed.created_at).toLocaleDateString()}</div></div><button class="btn-del" onclick="delReport(${viewed.id})">🗑 Delete</button></div><div class="rsnap"><div class="rsc"><div class="rsv">${viewed.snap?.staff||0}</div><div class="rsl">Staff</div></div><div class="rsc"><div class="rsv">${viewed.snap?.done||0}</div><div class="rsl">Done</div></div><div class="rsc"><div class="rsv">${viewed.snap?.clients||0}</div><div class="rsl">Clients</div></div></div>${[['summary','Summary'],['done_items','Done'],['stuck_items','Issues'],['next_week','Next week']].filter(([k])=>viewed[k]).map(([k,l])=>`<div class="rsec"><div class="rsec-t">${l}</div><div class="rsec-b">${esc(viewed[k])}</div></div>`).join('')}</div>`:S.showAddReport?'':'<div class="rempty">Select a report or create one</div>';
  return`<div class="ph">${S.lang==='ko'?'주간 보고서':'Reports — For Geonhui'}</div>
<div class="rlayout"><div><div class="shr"><div class="sh">Reports</div><button class="btn-add btn-sm" onclick="S.showAddReport=!S.showAddReport;S.viewReport=null;render()">+ New</button></div>${S.reports.map(r=>`<div class="ritem${S.viewReport===r.id?' on':''}" onclick="S.viewReport=${r.id};S.showAddReport=false;render()"><div style="font-size:12px;font-weight:700">${esc(r.week_label)}</div><div style="font-size:11px;color:#aaa">${new Date(r.created_at).toLocaleDateString()}</div></div>`).join('')||`<div style="font-size:12px;color:#aaa;padding:8px 0">No reports yet</div>`}</div><div>${addF||vH}</div></div>`;
}

// ── INVITE CODES ──────────────────────────────────────────────────────────
function pgInvite(){
  const roleBg={ceo:'#faeeda',manager:'#e8f5e9',settlement:'#e3f2fd',hr:'#eeedfe',staff:'#f5f5f5'};
  const roleClr={ceo:'#854F0B',manager:'#1D9E75',settlement:'#185FA5',hr:'#534AB7',staff:'#555'};
  const cards=S.codes.map(c=>`<div class="code-card"><div class="code-role" style="background:${roleBg[c.role]||'#f5f5f5'};color:${roleClr[c.role]||'#555'}">${c.role.toUpperCase()}</div><div class="code-val${c.is_used?' code-used':''}">${esc(c.code)}</div><div class="code-status">${c.is_used?'✓ Used':'Available'}</div><div style="font-size:11px;color:#aaa">${esc(c.label||'')}</div>${!c.is_used?`<button class="btn-del" onclick="delCode(${c.id})">🗑</button>`:''}</div>`).join('');
  const addF=S.showAddCode?`<div class="fbox"><div class="fbox-t">Generate invite code</div><div class="fgrid"><div class="fg2"><label>Role</label><select id="nc-role"><option value="manager">Manager</option><option value="settlement">Settlement</option><option value="hr">HR</option><option value="staff">Staff</option><option value="ceo">CEO</option></select></div><div class="fg2"><label>Label (who it's for)</label><input id="nc-label" placeholder="e.g. For Tori"></div><div class="fg2"><label>Custom code (optional)</label><input id="nc-code" placeholder="Auto-generated if empty"></div></div><div style="display:flex;gap:8px"><button class="btn-add" onclick="addCode()">Generate</button><button onclick="S.showAddCode=false;render()">Cancel</button></div></div>`:'';
  return`<div class="ph">Invite Codes</div>
<div class="psub">Share these codes with team members when they sign up</div>
<div class="shr"><div class="sh">${S.codes.filter(c=>!c.is_used).length} available · ${S.codes.filter(c=>c.is_used).length} used</div><button class="btn-add" onclick="S.showAddCode=!S.showAddCode;render()">+ Generate code</button></div>
${addF}${cards||`<div class="nodata">No invite codes yet — generate one above</div>`}`;
}

// ── USER ROLES ────────────────────────────────────────────────────────────
function pgUsers(){
  const roleBg={ceo:'#faeeda',manager:'#e8f5e9',settlement:'#e3f2fd',hr:'#eeedfe',staff:'#f5f5f5',player:'#ffebee'};
  const roleClr={ceo:'#854F0B',manager:'#1D9E75',settlement:'#185FA5',hr:'#534AB7',staff:'#555',player:'#b71c1c'};
  const all_roles=['ceo','manager','settlement','hr','staff','player'];
  const rows=S.team.map(m=>`<tr><td><div style="display:flex;align-items:center;gap:8px">${av(m.name,m.initials,26)}<div><strong>${esc(m.name)}</strong></div></div></td><td><span class="bdg" style="background:${roleBg[m.role]||'#f5f5f5'};color:${roleClr[m.role]||'#555'}">${ROLE_ICONS[m.role]||''} ${ROLE_LABELS[m.role]||m.role}</span></td><td style="white-space:nowrap">${m.id!==S.profile.id?`<select onchange="changeRole('${m.id}',this.value)" style="font-size:11px;padding:4px 8px;border:1px solid #dde1e7;border-radius:6px;font-family:inherit">${all_roles.map(r=>`<option value="${r}"${r===m.role?' selected':''}>${ROLE_LABELS[r]}</option>`).join('')}</select>`:`<span style="font-size:11px;color:#aaa">You</span>`}</td></tr>`).join('');
  return`<div class="ph">User Roles</div><div class="psub">Change anyone's role here. Changes take effect on their next page load.</div>
<div class="tw"><table><thead><tr><th>User</th><th>Current role</th><th>Change role</th></tr></thead><tbody>${rows}</tbody></table></div>
<div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:10px;padding:14px;font-size:12px;color:#1b5e20;line-height:1.7"><strong>Role summary:</strong><br>
👑 CEO &amp; 🟢 Manager — Full access to everything<br>
💰 Settlement — Dashboard, clients, financial<br>
👥 HR — Dashboard, tasks, recruitment, team directory<br>
🖥 Staff — Dashboard, Korea PCs (view), tasks (mark done)<br>
🎮 Player — Own order portal only</div>`;
}

// ── PLAYER PORTAL ─────────────────────────────────────────────────────────
function pgPlayer(){
  const o=S.playerOrder;
  if(!o) return`<div class="player-wrap"><div class="player-none"><div class="player-icon">🎮</div><div style="font-size:16px;font-weight:700;margin-bottom:8px">No order found</div><div style="font-size:13px;color:#aaa">Your account (${esc(S.user?.email)}) is not linked to any active service.<br>Contact Lucky 7 to get set up!</div></div></div>`;
  const stClr={Active:'#1D9E75',Completed:'#185FA5',Paused:'#BA7517'};
  return`<div class="player-wrap">
<div class="player-hero">
  <div class="player-char">${esc(o.char_info)}</div>
  <div class="player-server">${esc(o.server)}</div>
  <div class="player-status-big" style="background:${stClr[o.status]||'rgba(255,255,255,.2)'}">● ${o.status}</div>
</div>
<div class="player-card">
  <div class="player-card-title">Service details</div>
  <div class="player-row"><span class="player-key">Service</span><span class="player-val">${esc(o.service)}</span></div>
  <div class="player-row"><span class="player-key">Period</span><span class="player-val">${esc(o.start_date)} → ${esc(o.end_date)}</span></div>
  <div class="player-row"><span class="player-key">Price</span><span class="player-val">Rp ${(+o.price||0).toLocaleString()}</span></div>
</div>
${o.progress_note?`<div class="player-card"><div class="player-card-title">Progress note from team</div><div class="player-note">📝 ${esc(o.progress_note)}</div></div>`:''}
</div>`;
}

// ── ACTIONS ───────────────────────────────────────────────────────────────
async function cyclePC(id){const ord=['Online','Warning','Offline'];const p=S.pcs.find(x=>x.id===id);const ns=ord[(ord.indexOf(p.status)+1)%3];await sb.from('korea_pcs').update({status:ns}).eq('id',id);S.pcs=S.pcs.map(x=>x.id===id?{...x,status:ns}:x);render();}
function editNote(id){document.getElementById(`ne-${id}`).style.display='';}
async function saveNote(id){const v=document.getElementById(`ni-${id}`).value;await sb.from('korea_pcs').update({note:v}).eq('id',id);S.pcs=S.pcs.map(p=>p.id===id?{...p,note:v}:p);render();}
async function toggleTask(id){const x=S.tasks.find(t=>t.id===id);const ns=x.status==='Done'?'Todo':'Done';await sb.from('tasks').update({status:ns}).eq('id',id);S.tasks=S.tasks.map(t=>t.id===id?{...t,status:ns}:t);render();}
async function delTask(id){if(!confirm('Delete?'))return;await sb.from('tasks').delete().eq('id',id);S.tasks=S.tasks.filter(t=>t.id!==id);render();}
async function addTask(){const ti=document.getElementById('nt-t').value.trim();if(!ti)return;const {data}=await sb.from('tasks').insert({title:ti,title_ko:document.getElementById('nt-k').value,owner:document.getElementById('nt-o').value,priority:document.getElementById('nt-p').value,status:'Todo',category:document.getElementById('nt-c').value}).select().single();if(data)S.tasks.push(data);S.showAddTask=false;render();}
async function toggleClient(id){const ord=['Active','Paused','Completed'];const c=S.clients.find(x=>x.id===id);const ns=ord[(ord.indexOf(c.status)+1)%3];await sb.from('clients').update({status:ns}).eq('id',id);S.clients=S.clients.map(x=>x.id===id?{...x,status:ns}:x);render();}
async function delClient(id){if(!confirm('Delete?'))return;await sb.from('clients').delete().eq('id',id);S.clients=S.clients.filter(c=>c.id!==id);render();}
async function addClient(){const n=document.getElementById('nc-n').value.trim();if(!n)return;const {data}=await sb.from('clients').insert({name:n,char_info:document.getElementById('nc-ch').value,server:document.getElementById('nc-sv').value,service:document.getElementById('nc-sc').value,status:'Active',start_date:document.getElementById('nc-st').value,end_date:document.getElementById('nc-en').value,price:document.getElementById('nc-pr').value,player_email:document.getElementById('nc-em').value}).select().single();if(data)S.clients.push(data);S.showAddClient=false;render();}
function toggleEdit(id){S.editMember=S.editMember===id?null:id;render();}
function cancelEdit(){S.editMember=null;render();}
async function saveMember(id){const upd={name:document.getElementById('e-name').value,initials:document.getElementById('e-ini').value,isp:document.getElementById('e-isp').value,tool:document.getElementById('e-tool').value,since:document.getElementById('e-since').value};await sb.from('user_profiles').update(upd).eq('id',id);S.team=S.team.map(m=>m.id===id?{...m,...upd}:m);S.editMember=null;render();}
async function moveRecruit(id,stage){await sb.from('recruits').update({stage}).eq('id',id);S.recruits=S.recruits.map(r=>r.id===id?{...r,stage}:r);render();}
async function delRecruit(id){if(!confirm('Delete?'))return;await sb.from('recruits').delete().eq('id',id);S.recruits=S.recruits.filter(r=>r.id!==id);render();}
async function addRecruit(){const n=document.getElementById('nr-n').value.trim();if(!n)return;const {data}=await sb.from('recruits').insert({name:n,source:document.getElementById('nr-s').value,date_applied:document.getElementById('nr-d').value,stage:'Applied'}).select().single();if(data)S.recruits.push(data);S.showAddRecruit=false;render();}
async function addReport(){const wk=document.getElementById('rp-wk').value.trim();if(!wk)return;const snap={staff:S.team.length,done:S.tasks.filter(x=>x.status==='Done').length,clients:S.clients.filter(c=>c.status==='Active').length};const {data}=await sb.from('reports').insert({week_label:wk,summary:document.getElementById('rp-sum').value,done_items:document.getElementById('rp-don').value,stuck_items:document.getElementById('rp-stk').value,next_week:document.getElementById('rp-nxt').value,snap}).select().single();if(data){S.reports.unshift(data);S.viewReport=data.id;}S.showAddReport=false;render();}
async function delReport(id){if(!confirm('Delete?'))return;await sb.from('reports').delete().eq('id',id);S.reports=S.reports.filter(r=>r.id!==id);S.viewReport=null;render();}
function genCode(role){const chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let code='';for(let i=0;i<8;i++)code+=chars[Math.floor(Math.random()*chars.length)];return`${role.toUpperCase()}-${code}`;}
async function addCode(){const role=document.getElementById('nc-role').value;const label=document.getElementById('nc-label').value;const custom=document.getElementById('nc-code').value.trim();const code=custom||genCode(role);const {data}=await sb.from('invite_codes').insert({code,role,label}).select().single();if(data)S.codes.push(data);S.showAddCode=false;render();}
async function delCode(id){if(!confirm('Delete this code?'))return;await sb.from('invite_codes').delete().eq('id',id);S.codes=S.codes.filter(c=>c.id!==id);render();}
async function changeRole(id,role){if(!confirm(`Change this user's role to ${ROLE_LABELS[role]}?`))return;await sb.from('user_profiles').update({role}).eq('id',id);S.team=S.team.map(m=>m.id===id?{...m,role}:m);render();}

init();
</script>
</body>
